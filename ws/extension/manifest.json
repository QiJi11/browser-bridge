{
  "manifest_version": 3,
  "name": "Local WS Bridge",
  "version": "0.1.0",
  "description": "本机 ws://127.0.0.1:18786 桥的浏览器端：在真实登录态浏览器里执行读取/滚动/打开等命令。默认只读，不申请 debugger 权限。",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://example.com/*",
    "https://*.example.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
